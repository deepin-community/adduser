msgstr "Se selectează UID/GID-ul din intervalul %d până la %d ..."

#: ../adduser:1342
#, perl-format
msgid "Removing directory `%s' ..."
msgstr "Se elimină directorul „%s” ..."

#: ../adduser:1346 ../deluser:393
#, perl-format
msgid "Removing user `%s' ..."
msgstr "Se elimină utilizatorul „%s” ..."

