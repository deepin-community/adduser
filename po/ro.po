msgstr "Nu s-a putut crea directorul personal „%s”: %s."

#: ../adduser:945
#, perl-format
msgid "Copying files from `%s' ..."
msgstr "Se copiază fișierele din „%s” ..."

#: ../adduser:948
#, perl-format
